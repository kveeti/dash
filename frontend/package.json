{
  "name": "frontend",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "e2e": "pnpm run build && playwright test",
    "e2e:server": "exec ../scripts/e2e-server.sh",
    "e2e:fixtures": "playwright test --config playwright.fixtures.config.ts",
    "e2e:fixtures:server": "vite --config vite.fixtures.config.ts --port 3210"
  },
  "dependencies": {
    "@formisch/solid": "1.0.0-rc.0",
    "@kobalte/core": "^0.13.12",
    "@kobalte/utils": "^0.9.2",
    "@solid-primitives/deep": "^0.3.6",
    "@solidjs/router": "^0.15.1",
    "@tanstack/solid-query": "^5.101.2",
    "solid-js": "^1.9.5",
    "solid-transition-group": "^0.3.0",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.0",
    "eslint-plugin-solid": "^0.14.5",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "postcss": "^8.4.49",
    "sass": "^1.101.0",
    "solid-devtools": "^0.34.3",
    "vite": "^7.1.4",
    "vite-plugin-solid": "^2.11.8"
  }
}
